# New Docker Compose stack (required)
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:8080
PUBLIC_PORT=8080

# Legacy Supabase configuration (remove after migration parity)
VITE_SUPABASE_URL=https://hallsaapi.mohamedaref.com
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Application Settings
VITE_APP_NAME=SA-HALL
VITE_APP_URL=https://your-domain.com

# Feature Flags
VITE_ENABLE_FEATURED_HALLS=true
VITE_ENABLE_SUBSCRIPTIONS=true
